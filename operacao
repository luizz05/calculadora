<?php

$num1 = $_POST["num1"];
$num2 = $_POST["num2"];
$op = $_POST["op"];

if($op == +)
{
$resultado = $num1 + $num2;
}
else
{
if($op == -)
{
$resultado = $num1 - $num2;
}
else
{
if($op == *)
{
$resultado = $num1 * $num2;
}
else
{
if($op ==/)
{
$resultado = $num1 / $num2;
}
}
}
}
echo "resultado: $resultado";
?>
